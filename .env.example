# URL of the existing Next.js POS (accounting-web-app).
# Desktop never replaces that app — it only opens it in a native window.

# Local Next.js (run `npm run dev` in accounting-web-app first)
ELECTRON_APP_URL=http://127.0.0.1:3000

# Backend API for native login + OTP (same as web API_URL)
ELECTRON_API_URL=http://127.0.0.1:5000
# ELECTRON_API_URL=https://bisonstechs.up.railway.app

# Production hosted app
# ELECTRON_APP_URL=https://app.bisonstechs.com

# Optional generic auto-update feed (leave empty to skip)
ELECTRON_UPDATE_URL=

# Set to 1 to allow DevTools in packaged builds
ELECTRON_ALLOW_DEVTOOLS=
